<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Theme -->
    <style name="Theme.Btl" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/tl_primary</item>
        <item name="colorPrimaryVariant">@color/tl_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/tl_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/tl_primary_dark</item>
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialButtonStyle">@style/TL.Button</item>
        <item name="textInputStyle">@style/TL.TextInput</item>
    </style>

    <!-- Splash -->
    <style name="Theme.Btl.Splash" parent="Theme.Btl">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/tl_primary_dark</item>
    </style>

    <!-- Buttons -->
    <style name="TL.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/tl_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="rippleColor">@color/ripple</item>
    </style>

    <style name="TL.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/tl_primary</item>
        <item name="android:textColor">@color/tl_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TL.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/tl_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TL.Button.Danger" parent="TL.Button">
        <item name="backgroundTint">@color/error</item>
    </style>

    <!-- Text Input -->
    <style name="TL.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/tl_primary</item>
        <item name="hintTextColor">@color/tl_primary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/white</item>
    </style>

    <style name="TL.TextInput.Filled" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/gray_100</item>
        <item name="hintTextColor">@color/tl_primary</item>
        <item name="boxStrokeColor">@color/tl_primary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
    </style>

    <!-- Cards -->
    <style name="TL.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="contentPadding">0dp</item>
    </style>

    <style name="TL.Card.Flat" parent="TL.Card">
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <!-- Toolbar -->
    <style name="TL.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/tl_primary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white_80</item>
        <item name="navigationIconTint">@color/white</item>
    </style>

    <!-- Tabs -->
    <style name="TL.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabBackground">@color/tl_primary</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabTextColor">@color/white_80</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabGravity">fill</item>
        <item name="tabMode">fixed</item>
    </style>

    <!-- Text Styles -->
    <style name="TL.Text.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TL.Text.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TL.Text.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TL.Text.Value" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TL.Text.Header" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/tl_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="TL.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bnav_color_selector</item>
        <item name="itemTextColor">@color/bnav_color_selector</item>
        <item name="backgroundTint">@color/white</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Chip -->
    <style name="TL.Chip.Grade" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">8dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Dialog -->
    <style name="TL.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/tl_primary</item>
        <item name="colorAccent">@color/tl_primary</item>
    </style>

</resources>