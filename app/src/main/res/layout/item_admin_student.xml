<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Main info row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- Avatar -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_header_gradient">

                <TextView
                    android:id="@+id/tv_admin_item_initial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="N"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"/>
            </FrameLayout>

            <!-- Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_admin_item_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nguyễn Văn An"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">

                    <TextView
                        android:id="@+id/tv_admin_item_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A12345"
                        android:textSize="13sp"
                        android:textColor="@color/tl_primary"
                        android:textStyle="bold"/>

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@color/gray_300"
                        android:layout_marginHorizontal="8dp"/>

                    <TextView
                        android:id="@+id/tv_admin_item_class"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TT3601"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_admin_item_major"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Công nghệ thông tin"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Status badge -->
            <TextView
                android:id="@+id/tv_admin_item_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang học"
                android:textSize="10sp"
                android:textColor="@color/success"
                android:textStyle="bold"
                android:background="@drawable/bg_grade_a"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"/>

        <!-- Action buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_detail"
                style="@style/TL.Button.Text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:text="Chi tiết"
                android:textSize="13sp"/>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="@color/divider"
                android:layout_gravity="center_vertical"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_student"
                style="@style/TL.Button.Text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:text="Sửa"
                android:textSize="13sp"/>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="@color/divider"
                android:layout_gravity="center_vertical"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_student"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:backgroundTint="@android:color/transparent"
                android:textColor="@color/error"
                android:text="Xóa"
                android:textSize="13sp"
                app:cornerRadius="0dp"
                app:rippleColor="#1AC62828"/>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>